# Acoustic Task Manager - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=acoustic
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=acoustic

# ============================================
# RabbitMQ Configuration
# ============================================
RABBITMQ_USER=acoustic
RABBITMQ_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ============================================
# JWT Secrets
# Generate with: openssl rand -hex 32
# ============================================
JWT_SECRET=CHANGE_THIS_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=CHANGE_THIS_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ============================================
# Telegram Bot Configuration
# Get bot token from @BotFather on Telegram
# ============================================
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
NEXT_PUBLIC_TELEGRAM_BOT_NAME=your_bot_name_here

# ============================================
# Webhook Configuration
# Generate secret with: openssl rand -hex 32
# ============================================
WEBHOOK_SECRET=CHANGE_THIS_GENERATE_WITH_OPENSSL_RAND_HEX_32
WEBHOOK_URL=https://task.acoustic.uz/api/bot/webhook

# ============================================
# Internal Service Communication Secret
# Generate with: openssl rand -hex 32
# ============================================
INTERNAL_SECRET=CHANGE_THIS_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ============================================
# Application Configuration
# ============================================
ALLOWED_ORIGIN=https://task.acoustic.uz
NEXT_PUBLIC_API_URL=https://task.acoustic.uz/api
TZ=Asia/Tashkent
NODE_ENV=production
