{
  "name": "@acoustic/notification-service",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc && pnpm build:prisma",
    "build:prisma": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "clean": "rm -rf dist",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@acoustic/shared": "workspace:*",
    "@prisma/client": "^5.7.1",
    "express": "^4.18.2",
    "amqplib": "^0.10.3",
    "node-telegram-bot-api": "^0.64.0",
    "node-cron": "^3.0.3",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node-telegram-bot-api": "^0.64.0",
    "@types/node-cron": "^3.0.11",
    "@types/amqplib": "^0.10.4",
    "@types/node": "^20.11.0",
    "@types/express": "^4.17.21",
    "prisma": "^5.7.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "jest": "^29.7.0"
  }
}
